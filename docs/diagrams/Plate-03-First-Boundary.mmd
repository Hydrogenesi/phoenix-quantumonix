graph TD
    MOTION["Motion\n(Plate 02)"]
    BOUND["Boundary\nB1 Distinction"]
    INSIDE["Inside\nself"]
    OUTSIDE["Outside\nother"]
    RECIP["B2 Reciprocity"]
    CROSS["self -> self'\nB3 Identity Continuity"]

    MOTION --> BOUND
    BOUND --> INSIDE
    BOUND --> OUTSIDE
    INSIDE --> RECIP
    OUTSIDE --> RECIP
    RECIP --> CROSS

    style BOUND fill:#1a1a2e,color:#e0a800,stroke:#e0a800
    style RECIP fill:#16213e,color:#fff,stroke:#444
    style CROSS fill:#16213e,color:#e0a800,stroke:#e0a800
